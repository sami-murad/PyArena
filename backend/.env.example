# Backend settings for local development (uvicorn in a virtual environment).
# Copy to backend/.env. Every variable is optional; defaults are in app/config.py.

ENVIRONMENT=development

# PostgreSQL from docker-compose.dev.yml (or your own local install).
DATABASE_URL=postgresql+asyncpg://pyarena:pyarena@localhost:5432/pyarena
# No Docker and no PostgreSQL? This works for trying things out (single user, no concurrency guarantees):
# DATABASE_URL=sqlite+aiosqlite:///./pyarena-dev.db

# Connection pool (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# Redis for shared rate limits, presence, judge locks and Socket.IO across processes.
# Empty = keep all of that in memory, which is correct for ONE backend process (normal local
# development). docker-compose.dev.yml starts Redis on 127.0.0.1:6379 if you want to use it:
# REDIS_URL=redis://127.0.0.1:6379/0
# Required when ENVIRONMENT=production.
REDIS_URL=

# Logging: json (one object per line, for log collectors) or text (readable).
LOG_FORMAT=text
LOG_LEVEL=INFO

# Prometheus metrics at GET /metrics. Set METRICS_TOKEN to require "Authorization: Bearer <token>".
METRICS_ENABLED=true
METRICS_TOKEN=

# How long a response is remembered for a repeated Idempotency-Key.
IDEMPOTENCY_TTL_HOURS=24

# Random value, at least 32 characters, for signing session cookies.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
SESSION_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HEADERS=false

# Judge worker (docker-compose.dev.yml or `uvicorn runner:app --port 8001` in judge-worker/).
WORKER_URL=http://127.0.0.1:8001
WORKER_TOKEN=dev-only-worker-token
WORKER_TIMEOUT_SECONDS=20
# How long to wait for the worker to accept a connection before reporting it unreachable.
WORKER_CONNECT_TIMEOUT_SECONDS=3

# Playground limits
MAX_CODE_CHARS=20000
MAX_STDIN_CHARS=10000
PLAYGROUND_CPU_SECONDS=2
PLAYGROUND_WALL_SECONDS=5
PLAYGROUND_MEMORY_MB=256

# Competitions (set COMPETITION_MIN_PLAYERS=1 to test alone)
COMPETITION_MIN_PLAYERS=2
COMPETITION_MAX_PLAYERS=8
COMPETITION_COUNTDOWN_SECONDS=5
COMPETITION_IDLE_MINUTES=60
SUBMISSION_COOLDOWN_SECONDS=3

# Rate limits (per IP, or per user when signed in)
RATE_LIMIT_ENABLED=true
RATE_EXECUTE_PER_MINUTE=30
RATE_LOGIN_PER_MINUTE=10
RATE_REGISTER_PER_HOUR=20
RATE_JOIN_PER_MINUTE=20
RATE_SUBMIT_PER_MINUTE=30
RATE_FOCUS_PER_MINUTE=120

# Focus Mode (only in rooms where the host turns it on). Counted violations
# 1..WARN_LIMIT warn, the next pauses submissions, later ones freeze them, and
# number WARN_LIMIT + DQ_AFTER disqualifies. Absences under GRACE_MS never count.
FOCUS_WARN_LIMIT=3
FOCUS_PAUSE_SECONDS=30
FOCUS_FREEZE_SECONDS=60
FOCUS_DQ_AFTER=4
FOCUS_GRACE_MS=2000
FOCUS_PASTE_LIMIT_CHARS=200
FOCUS_HEARTBEAT_SECONDS=10
FOCUS_HEARTBEAT_GAP_SECONDS=45
