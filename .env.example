# Docker Compose settings for the full stack (docker compose up --build).
# Copy to .env and replace every CHANGE_ME. Never commit .env.
#
# Generate random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (scripts/setup.sh / setup.ps1 create .env with random values for you.)

POSTGRES_DB=pyarena
POSTGRES_USER=pyarena
POSTGRES_PASSWORD=CHANGE_ME

# Signs session cookies. At least 32 random characters.
SECRET_KEY=CHANGE_ME
# Shared secret between the API and the judge worker. At least 24 random characters.
WORKER_TOKEN=CHANGE_ME

# Public address of the site, used for CORS and invite links.
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# development | production. Production refuses to start with weak secrets
# or with COOKIE_SECURE=false, so only use it behind HTTPS.
ENVIRONMENT=development
COOKIE_SECURE=false

# Optional: require this bearer token to scrape GET /metrics on the internal network.
METRICS_TOKEN=

# Set to 1 to try competitions alone.
COMPETITION_MIN_PLAYERS=2
WORKER_MAX_CONCURRENT_JOBS=4
