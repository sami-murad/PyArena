# Judge worker settings. In Docker these come from docker-compose*.yml; for a
# local run, export them in your shell before `uvicorn runner:app --port 8001`.

# Shared secret with the backend (X-Worker-Token). Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_TOKEN=change-me

# Concurrent jobs. Each job gets its own UID when the worker runs as root.
WORKER_MAX_CONCURRENT_JOBS=4

# Ceilings: requests can ask for less, never more.
WORKER_MAX_CPU_SECONDS=5
WORKER_MAX_WALL_SECONDS=10
WORKER_MAX_MEMORY_MB=256
WORKER_MAX_OUTPUT_BYTES=65536
WORKER_MAX_PROCESSES=16
WORKER_MAX_CODE_CHARS=65536
WORKER_MAX_STDIN_CHARS=65536

# Where job directories are created (a tmpfs in Docker). Empty = system temp dir.
WORKER_WORK_ROOT=

# Per-job seccomp filter: auto (use when available), required (refuse to start
# without it; the Docker image sets this), off (debugging only).
WORKER_SECCOMP=auto

# Per-job cgroup v2 limits. Empty = disabled. Must be a delegated, empty cgroup
# v2 directory with the memory and pids controllers (see docker-compose.cgroup.yml).
WORKER_CGROUP_ROOT=

# Development only: GET /_diag (still needs the token). Never enable in production.
WORKER_ENABLE_DIAG=false
