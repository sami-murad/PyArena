# Public frontend settings. Copy to frontend/.env.local if you need to change them.
# Everything here is bundled into the browser JavaScript: NEVER put secrets here.

# Public address of the site (invite links, metadata).
VITE_SITE_URL=http://localhost:5173

# Leave empty to use the same origin (Vite proxy in development, nginx in Docker).
VITE_API_BASE_URL=
VITE_SOCKET_URL=

# Where the Vite dev server forwards /api and /socket.io (development only).
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Feature flags (true/false)
VITE_FEATURE_COMPETITIONS=true
VITE_FEATURE_SNIPPETS=true
VITE_FEATURE_ERROR_EXPLANATIONS=true
